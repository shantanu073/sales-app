# Copy to .env for local dev, or set as Azure App Service Application Settings.

# Blob Storage (feeds Snowpipe externally)
AZURE_STORAGE_CONNECTION_STRING=
CONTAINER_NAME=salesfiles

# Azure PostgreSQL (Operational ETL target)
POSTGRES_HOST=
POSTGRES_DB=salesdb
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_TABLE=sales_table

LOG_LEVEL=INFO
